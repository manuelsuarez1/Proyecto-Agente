{
  "extends": ["config:base"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchPackageNames": ["electron", "react", "react-dom", "vite"],
      "automerge": false,
      "labels": ["dependency-major"]
    }
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "timezone": "America/New_York",
  "schedule": ["before 4am on Monday"],
  "updateNotScheduled": false
}
